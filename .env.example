# ===== PostgreSQL（Docker Compose 与本地开发共用）=====
POSTGRES_USER=huahua
POSTGRES_PASSWORD=huahua_dev
POSTGRES_DB=huahua
# 本地开发（主机直连）
DATABASE_URL=postgresql://huahua:huahua_dev@localhost:5432/huahua?schema=public
# Docker Compose 内 api 使用（compose 内已覆盖）
# DATABASE_URL=postgresql://huahua:huahua_dev@postgres:5432/huahua?schema=public

# ===== Auth =====
# JWT 签名密钥（生产必须替换为 >=32 字节随机值）
JWT_SECRET=dev-secret-change-me-0123456789abcdef0123456789abcdef
JWT_EXPIRES_IN=30m
# Refresh 有效期（天）
REFRESH_TTL_DAYS=30

# ===== API / Web =====
API_PORT=3000
# Web（nginx）宿主端口；默认 8080。
# Windows 注意：8080 常被 Hyper-V 保留端口段占用，且该保留段会随重启变化
# （本机 2026-10-05 实测保留段为 8451-8550，覆盖了此前使用的 8500），
# 本地可在 .env 覆盖为远离动态段的端口（如 18080）。
# 排查保留段：netsh int ipv4 show excludedportrange protocol=tcp
WEB_PORT=8080
# Web 浏览器来源（逗号分隔）
CORS_ORIGINS=http://localhost:8080

# ===== 其他 =====
# 打卡日历日时区（P4 使用）
ATTENDANCE_TIMEZONE=Asia/Shanghai
# Mobile 客户端 API 基址（本地开发指向本机）
EXPO_PUBLIC_API_URL=http://localhost:3000/api
