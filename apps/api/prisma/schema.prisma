// P0 schema：identity（User + RefreshToken）。P1：Task/Completion/Approval/Growth。业务模块（Event/Attendance/WrongQuestion）P4+ 加入。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// seed is run via pnpm prisma:seed (node prisma/seed.js); 16 RewardProfile rows, idempotent upsert

model User {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username     String  @unique @db.VarChar(64)
  passwordHash String  @map("password_hash") @db.Text
  role         String  @default("child") @db.VarChar(16) // child/parent/teacher（VARCHAR + 应用层白名单惯例）
  familyId     String? @map("family_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  refreshTokens RefreshToken[]
  tasks         Task[]           @relation("TaskChild")
  completions   TaskCompletion[] @relation("CompletionChild")
  growth        UserGrowth?
  rewardGrants  RewardGrant[]    @relation("GrantUser")
  attendances   Attendance[]     @relation("AttendanceUser")
  growthCards   GrowthCard[]

  // 错题本相关归属（上游 User 上的字段/关系，原样保留）
  educationStage    String?          @map("education_stage") @db.VarChar(24)
  enrollmentYear    Int?             @map("enrollment_year") @db.SmallInt
  wrongQuestions    WrongQuestion[]  @relation("WrongQuestionChild")
  wrongQuestionTags KnowledgeTag[]   @relation("CustomTagChild")
  practiceRecords   PracticeRecord[]

  @@map("users")
}

// docs/auth-design.md §3：Refresh 仅存哈希；familyId 为轮换族；usedAt 非空即已消费（重放检测）
model RefreshToken {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  tokenHash           String    @unique @map("token_hash") @db.Text
  familyId            String    @map("family_id") @db.Uuid
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt              DateTime? @map("used_at") @db.Timestamptz(6)
  replacedByTokenHash String?   @map("replaced_by_token_hash") @db.Text
  revokedAt           DateTime? @map("revoked_at") @db.Timestamptz(6)
  ip                  String?   @db.VarChar(64)
  userAgent           String?   @db.VarChar(256)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], name: "idx_refresh_tokens_user_id")
  @@index([familyId], name: "idx_refresh_tokens_family_id")
  @@map("refresh_tokens")
}

// =====================================================================
// P1：Task / Completion / Approval / Growth（v1.2 §7.2）
// =====================================================================

// ---- 学习：任务（状态矩阵 = v1.2 §8.2：pending/in_progress/completed/returned）----
model Task {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  familyId         String    @map("family_id") @db.Uuid
  childId          String    @map("child_id") @db.Uuid
  title            String    @db.VarChar(128)
  description      String?   @db.Text
  subject          String?   @db.VarChar(32)
  priority         Int       @default(0) @db.SmallInt
  startAt          DateTime? @map("start_at") @db.Timestamptz(6)
  endAt            DateTime? @map("end_at") @db.Timestamptz(6)
  dueDate          DateTime? @map("due_date") @db.Date
  // 预计用时（分钟；仅展示，不参与日程定位）
  estimatedMinutes Int?      @map("estimated_minutes") @db.SmallInt
  // 8 预设色之一（huahuastudy 色板；日程/卡片用色）
  color            String?   @db.VarChar(16)
  // 任务图标 key（shared-types TASK_ICON_KEYS 白名单；NULL = 用中性默认图标）
  // 展示层字段：仅决定卡片/详情左上角那枚像素图标，不参与任何业务规则
  icon             String?   @db.VarChar(32)
  // 重复：位掩码 bit0=周一 … bit6=周日；0/空 = 不重复（仅日程展示层展开）
  repeatWeekdays   Int?      @map("repeat_weekdays") @db.SmallInt
  // 需人工确认时：任务创建人指定审核人（v1.2 §18#2：仅该审核人可审批）
  requiresApproval Boolean   @default(false) @map("requires_approval")
  reviewerId       String?   @map("reviewer_id") @db.Uuid
  // 奖励档（RewardProfile.code；NULL = CUSTOM 默认档，业务上不强制写 CUSTOM）
  rewardProfile    String?   @map("reward_profile") @db.VarChar(32)
  status           String    @default("pending") @db.VarChar(16)
  createdBy        String    @map("created_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  child            User             @relation("TaskChild", fields: [childId], references: [id], onDelete: Cascade)
  completions      TaskCompletion[]
  rewardGrants     RewardGrant[]
  rewardProfileRef RewardProfile?   @relation(fields: [rewardProfile], references: [code], onDelete: Restrict)

  @@index([familyId], name: "idx_tasks_family_id")
  @@index([childId], name: "idx_tasks_child_id")
  @@index([status], name: "idx_tasks_status")
  @@map("tasks")
}

// ---- 完成/提交（统一模型：一条流水线 + requiresApproval 可选闸门，v1.2 §8）----
// 同任务至多一个 pending 完成记录：部分唯一索引 (task_id) WHERE status='pending'（手写 SQL）
model TaskCompletion {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId            String    @map("task_id") @db.Uuid
  childId           String    @map("child_id") @db.Uuid
  note              String?   @db.Text
  evidenceJson      Json?     @map("evidence_json") @db.JsonB
  submittedAt       DateTime  @default(now()) @map("submitted_at") @db.Timestamptz(6)
  status            String    @default("pending") @db.VarChar(16) // pending/approved/rejected
  reviewedBy        String?   @map("reviewed_by") @db.Uuid
  reviewedAt        DateTime? @map("reviewed_at") @db.Timestamptz(6)
  reviewComment     String?   @map("review_comment") @db.Text
  approvalRequestId String?   @map("approval_request_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  task        Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  child       User         @relation("CompletionChild", fields: [childId], references: [id], onDelete: Cascade)
  rewardGrant RewardGrant?

  @@index([taskId], name: "idx_task_completions_task_id")
  @@index([childId], name: "idx_task_completions_child_id")
  @@map("task_completions")
}

// ---- 通用审批（完全通用：business_type/business_id；v1.2 §7.2）----
// 同业务对象至多一个 pending 申请：部分唯一索引 (business_type, business_id) WHERE status='pending'（手写 SQL）
model ApprovalRequest {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  childId      String    @map("child_id") @db.Uuid
  businessType String    @map("business_type") @db.VarChar(32)
  businessId   String    @map("business_id") @db.Uuid
  applicantId  String    @map("applicant_id") @db.Uuid
  reviewerId   String    @map("reviewer_id") @db.Uuid
  status       String    @default("pending") @db.VarChar(16) // pending/approved/rejected/cancelled
  comment      String?   @db.Text
  reviewedBy   String?   @map("reviewed_by") @db.Uuid
  reviewedAt   DateTime? @map("reviewed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  records ApprovalRecord[]

  @@index([familyId], name: "idx_approval_requests_family_id")
  @@index([childId], name: "idx_approval_requests_child_id")
  @@index([reviewerId], name: "idx_approval_requests_reviewer_id")
  @@index([status], name: "idx_approval_requests_status")
  @@map("approval_requests")
}

// 审批审计记录（Quorum audit_logs 模式）
model ApprovalRecord {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId String  @map("request_id") @db.Uuid
  action    String  @db.VarChar(32) // created/approved/rejected/cancelled
  actorId   String  @map("actor_id") @db.Uuid
  comment   String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  request ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId], name: "idx_approval_records_request_id")
  @@map("approval_records")
}

// ---- 成长：余额（1:1；等级派生不存储，v1.2 §18#3）----
model UserGrowth {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String  @unique @map("user_id") @db.Uuid
  xp           Decimal @default(0) @db.Decimal(12, 4)
  intelligence Decimal @default(0) @db.Decimal(12, 4)
  logic        Decimal @default(0) @db.Decimal(12, 4)
  expression   Decimal @default(0) @db.Decimal(12, 4)
  exploration  Decimal @default(0) @db.Decimal(12, 4)
  connection   Decimal @default(0) @db.Decimal(12, 4)
  vitality     Decimal @default(0) @db.Decimal(12, 4)
  coins        Decimal @default(0) @db.Decimal(12, 4)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_growth")
}

// 发放流水（幂等：UNIQUE(completion_id)；v1.2 §8 完成定稿节点发放）
model RewardGrant {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  taskId       String?  @map("task_id") @db.Uuid
  completionId String?  @unique @map("completion_id") @db.Uuid
  type         String   @default("base") @db.VarChar(16)
  xp           Decimal  @default(0) @db.Decimal(12, 4)
  intelligence Decimal  @default(0) @db.Decimal(12, 4)
  logic        Decimal  @default(0) @db.Decimal(12, 4)
  expression   Decimal  @default(0) @db.Decimal(12, 4)
  exploration  Decimal  @default(0) @db.Decimal(12, 4)
  connection   Decimal  @default(0) @db.Decimal(12, 4)
  vitality     Decimal  @default(0) @db.Decimal(12, 4)
  coins        Decimal  @default(0) @db.Decimal(12, 4)
  grantedAt    DateTime @default(now()) @map("granted_at") @db.Timestamptz(6)
  grantedBy    String   @map("granted_by") @db.Uuid

  user       User            @relation("GrantUser", fields: [userId], references: [id], onDelete: Cascade)
  task       Task?           @relation(fields: [taskId], references: [id], onDelete: SetNull)
  completion TaskCompletion? @relation(fields: [completionId], references: [id], onDelete: SetNull)

  @@index([userId], name: "idx_reward_grants_user_id")
  @@index([taskId], name: "idx_reward_grants_task_id")
  @@map("reward_grants")
}

// ---- 标准奖励档（系统配置，非用户 CRUD；seed 16 条：15 标准 + CUSTOM）----
// 奖励数值唯一来源是本表；shared-types 只放稳定 code/type，不复制数值。
// 删除策略 Restrict：不允许删除仍被 Task 引用的档位。NULL（Task.rewardProfile）业务上视为 CUSTOM。
model RewardProfile {
  code         String  @id @db.VarChar(32) // DAILY_CHINESE / ... / CUSTOM
  label        String  @db.VarChar(64)
  category     String  @db.VarChar(16) // daily / world / scenery / custom（仅分组展示）
  xp           Decimal @default(0) @db.Decimal(12, 4)
  intelligence Decimal @default(0) @db.Decimal(12, 4)
  logic        Decimal @default(0) @db.Decimal(12, 4)
  expression   Decimal @default(0) @db.Decimal(12, 4)
  exploration  Decimal @default(0) @db.Decimal(12, 4)
  connection   Decimal @default(0) @db.Decimal(12, 4)
  vitality     Decimal @default(0) @db.Decimal(12, 4)
  coins        Decimal @default(100) @db.Decimal(12, 4) // 金币：最低档 100（15 类不猜分档）
  isActive     Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tasks Task[]

  @@map("reward_profiles")
}

// =====================================================================
// P4：Attendance（打卡）—— 数据模型直接迁移 WorkPulse（MIT）
// 决策（v1.2 §18#4）：**完全独立于 Task**，仅 user_id + attendance_date；
// 防重第一道闸是**迁移里手写的唯一索引** uniq_attendances_user_date
// （并发下由 DB 兜底，服务层再捕获 23505 → 409 双保险，故此处不写 @@unique）。
// 不设 deleted_at：打卡是行为流水，V1 无删除语义（同 reward_grants 惯例）。
// =====================================================================
model Attendance {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  familyId       String    @map("family_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  attendanceDate DateTime  @map("attendance_date") @db.Date
  checkInAt      DateTime  @map("check_in_at") @db.Timestamptz(6)
  checkOutAt     DateTime? @map("check_out_at") @db.Timestamptz(6)
  // 由 check_in/check_out 派生（分钟）；未签退为 null
  totalMinutes   Int?      @map("total_minutes")
  status         String    @default("present") @db.VarChar(16)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation("AttendanceUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId], name: "idx_attendances_family_id")
  @@index([userId], name: "idx_attendances_user_id")
  @@map("attendances")
}

// =====================================================================
// P6：错题本（WrongQuestion）—— **逐字段对齐上游 wrong-notebook v1.9.1**
// 上游 model → 本项目 model：KnowledgeTag→KnowledgeTag、Subject→（用固定学科枚举，未采用自由科目表）、
//   ErrorItem→WrongQuestion、ReviewSchedule→WrongQuestionReview、PracticeRecord→PracticeRecord
// 硬基线适配（已登记，非发挥）：每表加 family_id/child_id；软删除 deleted_at；学科固定枚举；
//   图片存 key（上游 originalImageUrl 存 base64）；上游已废弃的 knowledgePoints 列**不移植**（单一来源=M2M tags）。
// =====================================================================

// 知识点标签（上游 KnowledgeTag：邻接表无限层级；系统预设 vs 用户自定义）
model KnowledgeTag {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  familyId String  @map("family_id") @db.Uuid
  name     String  @db.VarChar(64)
  subject  String  @db.VarChar(32)

  // 层级（邻接表；上游 parentId + onDelete: SetNull）
  parentId String?        @map("parent_id") @db.Uuid
  parent   KnowledgeTag?  @relation("TagHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children KnowledgeTag[] @relation("TagHierarchy")

  order Int     @default(0) @db.SmallInt
  code  String? @db.VarChar(32)

  // 系统预设 vs 自定义（上游 isSystem + userId；我们按孩子归属）
  isSystem Boolean @default(false) @map("is_system")
  childId  String? @map("child_id") @db.Uuid
  child    User?   @relation("CustomTagChild", fields: [childId], references: [id], onDelete: Cascade)

  questions WrongQuestion[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([familyId], name: "idx_knowledge_tags_family_id")
  @@index([subject], name: "idx_knowledge_tags_subject")
  @@index([parentId], name: "idx_knowledge_tags_parent_id")
  @@map("knowledge_tags")
}

// 错题（上游 ErrorItem；字段名逐一保留）
model WrongQuestion {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  familyId String @map("family_id") @db.Uuid
  // 上游 userId（错题本归属）→ 我们的 childId；另有 createdBy（家长可代录）
  childId   String @map("child_id") @db.Uuid
  createdBy String @map("created_by") @db.Uuid

  // 上游 subjectId（外键到自由科目表）→ 我们固定学科枚举（VARCHAR + 应用层白名单）
  subject String? @db.VarChar(32)

  // 图片：上游 originalImageUrl（base64）→ 我们存 key（P6-2 上传）
  originalImageKey String? @map("original_image_key") @db.VarChar(255)
  ocrText          String? @map("ocr_text") @db.Text

  // AI 解析结果（字段名同上游）
  questionText     String? @map("question_text") @db.Text
  answerText       String? @map("answer_text") @db.Text
  analysis         String? @db.Text
  wrongAnswerText  String? @map("wrong_answer_text") @db.Text
  mistakeAnalysis  String? @map("mistake_analysis") @db.Text
  mistakeStatus    String? @map("mistake_status") @db.VarChar(16)
  geogebraCommands String? @map("geogebra_commands") @db.Text

  // 用户元数据（字段名同上游）
  source    String? @db.VarChar(64)
  errorType String? @map("error_type") @db.VarChar(64)
  userNotes String? @map("user_notes") @db.Text

  // 掌握度（上游 0 New / 1 Reviewing / 2 Mastered）
  masteryLevel  Int     @default(0) @map("mastery_level") @db.SmallInt
  gradeSemester String? @map("grade_semester") @db.VarChar(48)
  paperLevel    String? @map("paper_level") @db.VarChar(8)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  child   User                @relation("WrongQuestionChild", fields: [childId], references: [id], onDelete: Cascade)
  tags    KnowledgeTag[]      // 上游 M2M（隐式连接表）
  reviews WrongQuestionReview[]

  @@index([familyId], name: "idx_wrong_questions_family_id")
  @@index([childId], name: "idx_wrong_questions_child_id")
  @@index([subject], name: "idx_wrong_questions_subject")
  @@index([masteryLevel], name: "idx_wrong_questions_mastery_level")
  @@map("wrong_questions")
}

// 复习记录（上游 ReviewSchedule：scheduledFor / completedAt / isCorrect）
model WrongQuestionReview {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  familyId        String        @map("family_id") @db.Uuid
  wrongQuestionId String        @map("wrong_question_id") @db.Uuid
  wrongQuestion   WrongQuestion @relation(fields: [wrongQuestionId], references: [id], onDelete: Cascade)

  scheduledFor DateTime  @map("scheduled_for") @db.Timestamptz(6)
  completedAt  DateTime? @map("completed_at") @db.Timestamptz(6)
  isCorrect    Boolean?  @map("is_correct")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([familyId], name: "idx_wrong_question_reviews_family_id")
  @@index([wrongQuestionId], name: "idx_wrong_question_reviews_question_id")
  @@map("wrong_question_reviews")
}

// 练习记录（上游 PracticeRecord；字段保持上游口径：subject/difficulty/isCorrect）
model PracticeRecord {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  familyId String  @map("family_id") @db.Uuid
  childId  String  @map("child_id") @db.Uuid

  subject    String? @db.VarChar(32)
  difficulty String? @db.VarChar(16)
  isCorrect  Boolean? @map("is_correct")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  child User @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([familyId], name: "idx_practice_records_family_id")
  @@index([childId], name: "idx_practice_records_child_id")
  @@map("practice_records")
}

// P6：每日成长卡（2026-10-07 方案 B：卡面由图片模型生成；文案由文本模型生成）
// 唯一索引 (user_id, card_date) = 同一天最多一次；刷新页面必须读历史而非重新生成
model GrowthCard {
  id          String    @id @default(uuid()) @db.Uuid
  familyId    String    @map("family_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  cardDate    DateTime  @map("card_date") @db.Date
  theme       String    @db.VarChar(32)
  title       String    @db.VarChar(64)
  message     String    @db.VarChar(200)
  imagePrompt String?   @map("image_prompt")
  imageUrl    String?   @map("image_url") @db.VarChar(300)
  status      String    @default("pending") @db.VarChar(32)
  generatedAt DateTime? @map("generated_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cardDate])
  @@index([familyId], name: "idx_growth_cards_family_id")
  @@map("growth_cards")
}